# Copy this file to .env and fill in the real values for your shelf:
#   cp .env.example .env

# === Shelf Config ===
SHELF_ID = "XX:XX:XX:XX:XX:XX" # MAC address of jetson nano
SHELF_ID_CLOUD = "<your-shelf-id-on-cloud>"

# === WiFi Hotspot Config ===
HOTSPOT_SSID = "SmartShelf-CS17IUH"
HOTSPOT_PASSWORD = "<hotspot-password>"

# === Voice Command Features ===
# Voice commands are handled automatically via xG26 voice sensor

# === Cloud Config ===
CLOUD_URL = "https://smart-shelf-server-backend.onrender.com/api/"

# === API key ===
GET_SEPAY_INFO_API_KEY = "https://smart-shelf-server-backend.onrender.com/api/sepay-config/shelf/<your-shelf-id-on-cloud>"
GET_PRODUCTS_API_KEY = "https://smart-shelf-server-backend.onrender.com/api/shelves/get-products/<your-shelf-id-on-cloud>"
GET_RFIDS_API_KEY = "https://smart-shelf-server-backend.onrender.com/api/shelves/get-employee/<your-shelf-id-on-cloud>"
GET_COMBOS_API_KEY = "https://smart-shelf-server-backend.onrender.com/api/combos"
GET_POSTERS_API_KEY = "https://smart-shelf-server-backend.onrender.com/api/posters"
POST_ORDER_API_KEY = "https://smart-shelf-server-backend.onrender.com/api/orders"
POST_HISTORY_ADDED_PRODUCTS_API_KEY = "https://smart-shelf-server-backend.onrender.com/api/histories"


# === Broker Config ===
BROKER_URL = "broker.hivemq.com"
BROKER_PORT = 8000
MQTT_LOADCELL_TOPIC = "shelf/loadcell/quantity"
MQTT_SENSOR_TOPIC = "shelf/sensor/environment"
MQTT_SHELF_STATUS_TOPIC = "shelf/status/data"
MQTT_UNPAID_CUSTOMER_TOPIC = "shelf/tracking/unpaid_customer"
MQTT_PAYMENT_TOPIC = "payment/notification"
MQTT_PRODUCT_ADDED_TOPIC = "shelf/product/added"

# === Service Sepay Config ===
SEPAY_TRANSACTION_URL = "https://my.sepay.vn/userapi/transactions/list"
SEPAY_TRANSACTION_DETAIL_URL = "https://my.sepay.vn/userapi/transactions/details"
VIETQR_PAYMENT_URL = "https://api.vietqr.io/v2/generate"

# NOTE: Sepay credentials are stored in database/sepay_info.json
# This file is loaded via cloud_sync.py and accessible through globals.sepay_info

